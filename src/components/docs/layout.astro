---
import "../../styles/global.css";
import Head from "../Head.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../../lib/site";
import Consent from "../Consent.astro";

interface Props {
  title: string;
  description: string;
  origin?: string;
  /** This page's Markdown twin, advertised as rel=alternate. */
  markdown?: string;
  /** Site-relative social card for this page. */
  image?: string;
}

const { title, description, origin = SITE.docsUrl, markdown, image } = Astro.props;
---

<!doctype html>
<html lang="en" data-design="reader">
  <head>
    <Head title={title} description={description} type="article" origin={origin} image={image} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="All documentation as one Markdown file" />
    <script is:inline>
      // Match next-themes before first paint and before Astro swaps documents.
      function applyReadingTheme(root) {
        let theme = "system";
        try { theme = localStorage.getItem("theme") || theme; } catch {}
        const dark = theme === "dark" || (theme === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", dark);
        root.classList.toggle("light", !dark);
        root.style.colorScheme = dark ? "dark" : "light";
      }
      applyReadingTheme(document.documentElement);
      document.addEventListener("astro:before-swap", (event) => {
        if (event.newDocument.documentElement.dataset.design === "reader") {
          applyReadingTheme(event.newDocument.documentElement);
        }
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#docs-main">Skip to documentation</a>
    <slot />
    <Consent />
  </body>
</html>
