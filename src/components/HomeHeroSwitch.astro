<slot />
<section id="home-light" class="home-light" aria-label="PHUX live workspace"></section>
<nav class="hero-view-options" aria-label="Homepage view">
  <button type="button" aria-controls="home-light" data-hero-toggle hidden>Classic view</button>
</nav>
<noscript>
  <style>[data-classic-home]{display:block!important}.home-light,.hero-view-options{display:none!important}</style>
</noscript>

<script>
  import { homeHero, heroSearch, type HomeHero } from "../lib/home-hero";
  const toggle=document.querySelector<HTMLButtonElement>("[data-hero-toggle]");
  const classic=document.querySelector<HTMLElement>("[data-classic-home]");
  const light=document.getElementById("home-light");
  if(toggle&&classic&&light){
    let frame:HTMLIFrameElement|null=null;
    const show=(hero:HomeHero)=>{
      const enabled=hero==="light";
      document.documentElement.dataset.homeHero=hero;
      classic.hidden=enabled;light.hidden=!enabled;
      toggle.textContent=enabled?"Classic view":"Live workspace";
      // The classic dialog and tour release before another client is admitted.
      document.dispatchEvent(new CustomEvent("phux:hero-view",{detail:hero}));
      if(enabled&&!frame){
        frame=document.createElement("iframe");
        frame.title="PHUX live workspace — interactive homepage";
        frame.src="/concepts/vgpu?variant=combo&embedded=home";
        light.append(frame);
      }else if(!enabled&&frame){
        frame.remove();frame=null;light.style.removeProperty("height");
      }
    };
    toggle.hidden=false;
    show(homeHero(location.search,document.documentElement.dataset.nativeAuthResult,document.documentElement.dataset.homeHero));
    toggle.addEventListener("click",()=>{
      const hero=document.documentElement.dataset.homeHero==="light"?"classic":"light";
      show(hero);
      const url=new URL(location.href);url.search=heroSearch(url.search,hero);
      history.replaceState(history.state,"",url);
    });
    window.addEventListener("popstate",()=>show(homeHero(location.search,document.documentElement.dataset.nativeAuthResult)));
    window.addEventListener("resize",()=>frame?.contentWindow?.postMessage({type:"phux:hero-viewport"},location.origin));
    window.addEventListener("message",event=>{
      if(!frame||event.origin!==location.origin||event.source!==frame.contentWindow)return;
      if(event.data?.type!=="phux:hero-height"||!Number.isFinite(event.data.height))return;
      light.style.height=`${Math.max(620,Math.min(2400,event.data.height))}px`;
    });
  }
</script>

<style is:global>
  html[data-home-hero="light"] [data-classic-home]{display:none}
</style>
<style>
  .home-light{position:relative;height:max(700px,calc(100svh - 108px));background:#080e14}
  .home-light :global(iframe){display:block;width:100%;height:100%;border:0}
  .hero-view-options{width:min(calc(100% - 48px),1072px);margin:0 auto;min-height:44px;display:flex;justify-content:flex-end;align-items:center;color:#7e8b94;font-size:10px}
  .hero-view-options button{min-height:44px;padding:0 6px;border:0;background:none;color:inherit;font:inherit;cursor:pointer}
  .hero-view-options button[hidden]{display:none}
  .hero-view-options button:hover{color:#d3e2e8}
  .hero-view-options button:focus-visible{outline:2px solid #c2dce7;outline-offset:2px;border-radius:8px}
</style>
