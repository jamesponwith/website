<section class="workspace-section" id="live-workspace" aria-labelledby="workspace-title">
  <div class="workspace-heading">
    <div><h2 id="workspace-title">Browser demo</h2><p>A disposable phux shell in your browser.</p></div>
    <a href="/embed">Open full shell <span aria-hidden="true">↗</span></a>
  </div>
  <div id="home-light" class="workspace-frame" aria-label="phux browser demo">
    <div class="workspace-placeholder"><span aria-hidden="true">⌘</span><p>The workspace connects when it comes into view.</p><a href="/concepts/vgpu?variant=combo">Open the browser demo ↗</a></div>
  </div>
  <p class="workspace-note">Limited demo shell · no sign-in</p>
</section>
<script>
  import { homeHero } from "../lib/home-hero";
  const host = document.getElementById("home-light");
  if (host) {
    let frame: HTMLIFrameElement | null = null;
    let inView = false;
    let release: ReturnType<typeof setTimeout> | undefined;
    const disconnect = () => {
      frame?.remove();
      frame = null;
      host.removeAttribute("data-connected");
    };
    const connect = () => {
      clearTimeout(release);
      if (frame) return;
      frame = document.createElement("iframe");
      frame.title = "phux browser demo";
      frame.src = "/concepts/vgpu?variant=combo&embedded=home";
      frame.allow = "clipboard-write; web-share";
      host.append(frame);
      host.dataset.connected = "true";
    };
    // A hidden iframe is still a running app. Remove it offscreen so its GPU,
    // workers, animation loops and disposable connection really are released.
    const sync = () => {
      clearTimeout(release);
      if (inView && !document.hidden) connect();
      else release = setTimeout(disconnect, 800);
    };
    const observer = new IntersectionObserver(([entry]) => { inView = Boolean(entry?.isIntersecting); sync(); }, { threshold: 0.05 });
    observer.observe(host);
    document.addEventListener("visibilitychange", sync);
    window.addEventListener("pagehide", disconnect);
    window.addEventListener("pageshow", sync);
    let width = innerWidth;
    window.addEventListener("resize", () => {
      if (innerWidth === width) return;
      width = innerWidth;
      // The child's 100svh minimum cannot shrink a formerly taller frame.
      // Rebase on width changes, then remeasure without replacing its session.
      host.style.removeProperty("height");
      void host.offsetHeight;
      frame?.contentWindow?.postMessage({ type: "phux:hero-viewport" }, location.origin);
    });
    window.addEventListener("message", event => {
      if (!frame || event.origin !== location.origin || event.source !== frame.contentWindow) return;
      if (event.data?.type !== "phux:hero-height" || !Number.isFinite(event.data.height)) return;
      const height = Math.max(520, Math.min(1200, event.data.height));
      host.style.height = `${height}px`;
    });
    // Preserve old shared live-workspace links without hiding the homepage.
    if (homeHero(location.search, document.documentElement.dataset.nativeAuthResult, document.documentElement.dataset.homeHero) === "light") {
      host.scrollIntoView({ block: "center", behavior: "instant" });
    }
  }
</script>
<style>
  .workspace-section { width: min(calc(100% - 80px), 1160px); margin-inline: auto; padding-top: 76px; scroll-margin-top: 32px; }
  .workspace-heading { margin: 0 auto 28px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  h2 { margin: 0; color: #e7e2da; font-size: clamp(28px, 3vw, 38px); font-weight: 550; letter-spacing: -.03em; line-height: 1.12; }
  .workspace-heading p { max-width: 52ch; margin: 12px 0 0; color: #adb8b0; font-size: 16px; line-height: 1.6; }
  .workspace-heading > a { display: inline-flex; align-items: center; gap: 16px; flex: none; min-height: 44px; color: #d2e3ec; font-size: 13px; }
  .workspace-heading > a:hover { text-decoration: underline; }
  .workspace-frame { position: relative; height: 620px; border-radius: 16px; background: #0a0c0d; overflow: hidden; contain: layout paint; box-shadow: 0 0 0 1px #c8d0c025, 0 24px 80px #0003; }
  .workspace-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .workspace-placeholder { height: 100%; display: grid; align-content: center; justify-items: center; gap: 12px; padding: 24px; text-align: center; color: #9cafbd; font-size: 13px; }
  .workspace-placeholder > span { font-size: 32px; color: #c2d9e5; }
  .workspace-placeholder p { margin: 0; }
  .workspace-placeholder a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 4px; color: #c2d9e5; }
  .workspace-frame[data-connected] .workspace-placeholder { visibility: hidden; }
  .workspace-note { margin: 14px auto 0; color: #8a978d; font-size: 11px; text-align: center; }
  .workspace-note a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .workspace-section { width: calc(100% - 56px); } }
  @media (max-width: 650px) { .workspace-section { width: calc(100% - 40px); padding-top: 64px; } .workspace-heading { flex-direction: column; align-items: start; gap: 8px; margin-bottom: 18px; } .workspace-heading p { font-size: 13px; } .workspace-frame { border-radius: 10px; } }
</style>
