---
// The hero fox: a cut-out rig of the generated metal fox kit (rig.ts),
// animated in motion.ts. Reduced motion and no-JS show the mascot still.
import { RIG, markup } from "./rig";
import { GROUND } from "./motion";
const rig = markup(RIG, "/fox/parts");
---
<div class="fox-stage">
  <img class="fox-poster" src="/fox/mascot.webp" width="1100" height="767" alt="" decoding="async" />
  <svg data-fox class="fox-rig" viewBox="-680 -420 1260 976" fill="none" role="img" aria-label="The phux silver fox">
    <title>The phux silver fox</title>
    <defs>
      <radialGradient id="fox-ground"><stop stop-color="#020809" stop-opacity=".75" /><stop offset="1" stop-color="#020809" stop-opacity="0" /></radialGradient>
    </defs>
    <g class="fox-approach">
      <ellipse class="fox-shadow" cx="-60" cy={GROUND} rx="400" ry="30" fill="url(#fox-ground)" />
      <g class="fox-body" set:html={rig} />
    </g>
  </svg>
  <noscript><style is:inline>.fox-stage .fox-poster { display: block !important } .fox-stage .fox-rig { visibility: hidden !important }</style></noscript>
</div>
<script>
  import { trackFox } from "./tracking";
  import { animateFox } from "./motion";
  const svg = document.querySelector<SVGSVGElement>("[data-fox]");
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  if (svg) {
    trackFox(svg);
    let stop: (() => void) | undefined;
    const start = async () => {
      if (still.matches || stop) return;
      // Start once every part has decoded, so no piece pops in mid-hop.
      const hrefs = [...svg.querySelectorAll("image")].map(image => image.getAttribute("href")!);
      const decoded = Promise.all(hrefs.map(href => { const img = new Image(); img.src = href; return img.decode().catch(() => {}); }));
      await Promise.race([decoded, new Promise(resolve => setTimeout(resolve, 4000))]);
      if (!still.matches) stop = animateFox(svg);
    };
    void start();
    still.addEventListener("change", () => { if (still.matches) { stop?.(); } else { stop = undefined; void start(); } });
  }
</script>
<style>
  .fox-stage { position: relative; width: 100%; aspect-ratio: 1260 / 976; isolation: isolate; }
  .fox-stage::before { content: ""; position: absolute; z-index: -1; inset: 8% -8% 0; border-radius: 50%; background: radial-gradient(ellipse, var(--fox-halo), transparent 66%); }
  .fox-poster { display: none; position: absolute; inset: 6% 2% 4%; width: 96%; height: 90%; object-fit: contain; }
  svg { display: block; width: 100%; height: 100%; overflow: visible; }
  /* Hidden until the entrance starts; shown at rest if the script never does. */
  .fox-approach { opacity: 0; }
  .fox-rig:not([data-live]) .fox-approach { animation: fox-fallback .4s 2.5s forwards; }
  @keyframes fox-fallback { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .fox-poster { display: block; }
    .fox-rig { visibility: hidden; }
  }
</style>
