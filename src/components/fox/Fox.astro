---
// The hero fox: a 3D fox in brushed metal (scene.ts) walks in when motion is
// allowed; reduced motion, no-JS and no-WebGL show the mascot still instead.
---
<div class="fox-stage" data-fox>
  <img class="fox-poster" src="/fox/mascot.webp" width="1100" height="767" alt="The phux silver fox" decoding="async" />
  <canvas class="fox-canvas" aria-hidden="true"></canvas>
</div>
<!-- Before first paint: motion visitors wait for the 3D fox, not the still. -->
<script is:inline>matchMedia("(prefers-reduced-motion: reduce)").matches || document.currentScript.previousElementSibling.setAttribute("data-pending", "")</script>
<script>
  import { trackFox } from "./tracking";
  const stage = document.querySelector<HTMLElement>("[data-fox]");
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  if (stage) {
    let fox: { look(x: number, y: number): void; stop(): void } | undefined;
    trackFox(stage, (x, y) => fox?.look(x, y));
    const start = async () => {
      if (still.matches || fox) return;
      try {
        // three.js loads only here, after first paint and only for motion.
        const { startFox } = await import("./scene");
        fox = await startFox(stage.querySelector("canvas")!, "/fox/fox.glb");
        stage.dataset.live = "";
      } catch {
        // No WebGL or no model: the mascot stays.
      } finally {
        delete stage.dataset.pending;
      }
    };
    if (document.readyState === "complete") void start();
    else addEventListener("load", () => void start(), { once: true });
    still.addEventListener("change", () => {
      if (!still.matches) return void start();
      fox?.stop();
      fox = undefined;
      delete stage.dataset.live;
    });
  }
</script>
<style>
  .fox-stage { position: relative; width: 100%; aspect-ratio: 620 / 480; isolation: isolate; }
  .fox-stage::before { content: ""; position: absolute; z-index: -1; inset: 8% -8% 0; border-radius: 50%; background: radial-gradient(ellipse, var(--fox-halo), transparent 66%); }
  .fox-poster { position: absolute; inset: 8% 0 4%; width: 100%; height: 88%; object-fit: contain; transition: opacity .3s; }
  .fox-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .fox-canvas { opacity: 0; transition: opacity .4s; }
  /* While the 3D fox loads or plays, the still steps aside. */
  .fox-stage:is([data-pending], [data-live]) .fox-poster { opacity: 0; }
  .fox-stage[data-live] .fox-canvas { opacity: 1; }
</style>
